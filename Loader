-- Steel Titans / Matcha v15
-- Uses the live Main.Hitboxes + Stats.Health + Owner structure.
-- Stop: _G.SteelTitansESP.Stop()
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LP = Players.LocalPlayer
assert(LP and Drawing and WorldToScreen, "Matcha/game is not ready")

if _G.SteelTitansESP then _G.SteelTitansESP.Stop() end
_G.__STEELTITANS_MATCHA_ESP_V11_RUN =
    (tonumber(_G.__STEELTITANS_MATCHA_ESP_V11_RUN) or 0) + 1

local C = {
    Enabled = true, Box = true, Name = true, Distance = true,
    Health = true, Tracer = true, TeamCheck = true,
    MaxDistance = 8000, BoxScale = 1.10, TextSize = 14,
}
local S = { Running = true, Config = C, Tracked = 0, Visible = 0,
    Frames = 0, Errors = 0, LastError = "", Pool = {} }
_G.SteelTitansESP = S
local POOL_SIZE = 32
local targets, camera, connection = {}, nil, nil
local red = Color3.fromRGB(255, 0, 0)
local green = Color3.fromRGB(0, 255, 0)
local blue = Color3.fromRGB(80, 170, 255)
local black = Color3.fromRGB(0, 0, 0)
local uiReady = false

local function hide(slot)
    for _, d in pairs(slot) do d.Visible = false end
end

function S.Stop()
    if not S.Running then return end
    S.Running = false
    if connection then pcall(function() connection:Disconnect() end) end
    for _, slot in ipairs(S.Pool) do
        for _, d in pairs(slot) do pcall(function() d:Remove() end) end
    end
    S.Visible = 0
end

local function report(where, err)
    S.Errors = S.Errors + 1
    local message = where .. ": " .. tostring(err)
    if message ~= S.LastError then
        S.LastError = message
        warn("[Steel Titans v15] " .. message)
    end
end


-- This Matcha build ignores Drawing.Text.Size. Raster labels use Image.Size,
-- which really scales; the embedded 10x20 ASCII font needs no external files.
local FONT = base64decode("")
local labelMeta, imageCache, cacheOrder = {}, {}, {}
local crcTable = {}
for n = 0, 255 do
    local c = n
    for j = 1, 8 do
        c = bit32.bxor(bit32.rshift(c,1), bit32.band(c,1) == 1 and 0xEDB88320 or 0)
    end
    crcTable[n] = c
end
local function be32(n)
    return string.char(bit32.band(bit32.rshift(n,24),255),
        bit32.band(bit32.rshift(n,16),255),bit32.band(bit32.rshift(n,8),255),bit32.band(n,255))
end
local function chunk(kind, data)
    local raw, crc = kind..data, 0xFFFFFFFF
    for i = 1, #raw do
        crc = bit32.bxor(bit32.rshift(crc,8),crcTable[bit32.band(bit32.bxor(crc,string.byte(raw,i)),255)])
    end
    return be32(#data)..raw..be32(bit32.bnot(crc))
end
local function makeLabel(text, color)
    text = text:gsub("[^ -~]", "?")
    local key = text..":"..color.R..":"..color.G..":"..color.B
    if imageCache[key] then return imageCache[key] end
    local w,h = math.max(1,#text)*10+2,22
    local ink = {}
    for i = 1, #text do
        local base = (string.byte(text,i)-32)*40
        for y = 0, 19 do
            local bits = string.byte(FONT,base+y*2+1)+256*string.byte(FONT,base+y*2+2)
            for x = 0, 9 do
                if bit32.band(bits,2^x) ~= 0 then ink[(y+1)*w+(i-1)*10+x+1] = true end
            end
        end
    end
    local rows = {}
    for y = 0, h-1 do
        local row = {string.char(0)}
        for x = 0, w-1 do
            local p = y*w+x
            local value = 0
            if ink[p] then value = 2
            else
                for dy = -1, 1 do
                    for dx = -1, 1 do
                        if x+dx >= 0 and x+dx < w and ink[(y+dy)*w+x+dx] then value = 1 end
                    end
                end
            end
            row[#row+1] = string.char(value)
        end
        rows[#rows+1] = table.concat(row)
    end
    local raw = table.concat(rows)
    local a,b = 1,0
    for i = 1, #raw do a=(a+string.byte(raw,i))%65521; b=(b+a)%65521 end
    local blocks = {string.char(120,1)}
    for start = 1, #raw, 65535 do
        local block = raw:sub(start,start+65534)
        local n = #block
        local inverse = 65535-n
        blocks[#blocks+1] = string.char(start+n>#raw and 1 or 0,n%256,math.floor(n/256),
            inverse%256,math.floor(inverse/256))..block
    end
    blocks[#blocks+1] = be32(b*65536+a)
    local palette = string.char(0,0,0,0,0,0,
        math.floor(color.R*255+0.5),math.floor(color.G*255+0.5),math.floor(color.B*255+0.5))
    local png = "\137PNG\r\n\26\n"
        ..chunk("IHDR",be32(w)..be32(h)..string.char(8,3,0,0,0))
        ..chunk("PLTE",palette)..chunk("tRNS",string.char(0,255,255))
        ..chunk("IDAT",table.concat(blocks))..chunk("IEND","")
    local result = {Data=png,Width=w,Height=h}
    imageCache[key] = result
    cacheOrder[#cacheOrder+1] = key
    if #cacheOrder > 256 then imageCache[table.remove(cacheOrder,1)] = nil end
    return result
end
local function setLabel(d, text, color)
    local previous = labelMeta[d]
    if previous and previous.Text == text then return end
    local bitmap = makeLabel(text,color)
    d.Data = bitmap.Data
    labelMeta[d] = {Text=text,Width=bitmap.Width,Height=bitmap.Height}
end

local function layoutLabels(d, x, y, w, h, vp, occupied)
    local entries = {}
    local widest,total = 0,0
    local scale = C.TextSize/20
    local gap = math.max(3,math.ceil(C.TextSize*0.2))
    local function add(obj, enabled)
        obj.Visible = false
        local m = labelMeta[obj]
        if enabled and m and m.Text ~= "" then
            local iw,ih = math.ceil(m.Width*scale),math.ceil(m.Height*scale)
            entries[#entries+1] = {Object=obj,Width=iw,Height=ih}
            widest = math.max(widest,iw)
            total = total+ih+gap
            obj.Size = Vector2.new(iw,ih)
        end
    end
    add(d.Name,C.Name)
    add(d.HPText,C.Health)
    add(d.Info,C.Distance)
    if #entries == 0 then return end
    total = total-gap
    local left = math.max(2,math.min(vp.X-widest-2,x+w/2-widest/2))
    local top = y-total-gap
    local function overlaps(rect)
        return left < rect.X+rect.W+gap and left+widest+gap > rect.X
            and top < rect.Y+rect.H+gap and top+total+gap > rect.Y
    end
    -- Try above, then below. Shift complete label blocks, never individual rows.
    local placed = false
    for pass = 1, 2 do
        top = pass == 1 and y-total-gap or y+h+gap
        for attempt = 1, #occupied+1 do
            local collision = nil
            for _,rect in ipairs(occupied) do
                if overlaps(rect) then collision=rect; break end
            end
            if not collision then
                placed = top >= 2 and top+total <= vp.Y-2
                break
            end
            top = pass == 1 and collision.Y-total-gap or collision.Y+collision.H+gap
        end
        if placed then break end
    end
    if not placed then return end -- Keep boxes/tracers when text cannot fit.
    occupied[#occupied+1] = {X=left,Y=top,W=widest,H=total}
    for _,entry in ipairs(entries) do
        entry.Object.Position = Vector2.new(left+(widest-entry.Width)/2,top)
        entry.Object.Visible = true
        top = top+entry.Height+gap
    end
end

local function drawing(kind, color, filled, thickness)
    local isLabel = kind == "Text"
    local d = Drawing.new(isLabel and "Image" or kind)
    d.Visible = false
    d.Transparency = 1 -- Verified on this running build: 1 is visible.
    d.Color = isLabel and Color3.fromRGB(255,255,255) or color
    if isLabel then
        d.Size = Vector2.new(1,1)
    else
        d.Thickness = thickness or 1
        if kind == "Square" then d.Filled = filled or false end
    end
    return d
end

local function setup()
    for i = 1, POOL_SIZE do
        local slot = {}
        S.Pool[i] = slot
        slot.Outline = drawing("Square", black, false, 3)
        slot.Box = drawing("Square", black, false, 2)
        slot.Name = drawing("Text", blue)
        slot.Info = drawing("Text", red)
        slot.HPText = drawing("Text", green)
        slot.HealthBG = drawing("Square", black, true)
        slot.Health = drawing("Square", green, true)
        slot.Tracer = drawing("Line", red, false, 2)
    end
    if type(UI) ~= "table" then return end
    local ok, err = pcall(function()
        if UI.RemoveTab then UI.RemoveTab("Steel Titans") end
        UI.AddTab("Steel Titans", function(tab)
            local e = tab:Section("Tank ESP", "Left")
            e:Toggle("st15_Enabled", "Enabled", C.Enabled)
            e:Toggle("st15_Box", "Box", C.Box)
            e:Toggle("st15_Name", "Name", C.Name)
            e:Toggle("st15_Distance", "Distance", C.Distance)
            e:Toggle("st15_Health", "Health", C.Health)
            e:Toggle("st15_Tracer", "Tracer", C.Tracer)
            e:Toggle("st15_TeamCheck", "Hide teammates", C.TeamCheck)
            local opts = tab:Section("ESP Settings", "Right")
            opts:SliderFloat("st15_BoxScale", "Box Size", 1, 3, C.BoxScale, "%.2fx")
            opts:SliderInt("st15_TextSize", "Text Size", 10, 28, C.TextSize)
            opts:Text("Range locked to 8000 studs")
            opts:Text("Unknown max HP: numeric HP only")
            local credits = tab:Section("Credits", "Right")
            credits:Text("Credits will be added later.")
        end)
    end)
    uiReady = ok
    if not ok then report("UI", err) end
end

local function syncUI()
    C.MaxDistance = 8000
    if not uiReady then return end
    for key, value in pairs(C) do
        local ok, v = pcall(function() return UI.GetValue("st15_" .. key) end)
        if key ~= "MaxDistance"
            and ok and type(v) == type(value) then C[key] = v end
    end
    C.BoxScale = math.max(1, math.min(3, C.BoxScale))
    C.TextSize = math.floor(math.max(10, math.min(28, C.TextSize)))
end

local function child(o, name)
    return o and o:FindFirstChild(name)
end

local function finite(n)
    return type(n) == "number" and n == n and math.abs(n) < 10000000
end

local function vectorOK(v)
    return v and finite(v.X) and finite(v.Y) and finite(v.Z)
end

local function isPart(o)
    local c = o.ClassName -- Matcha IsA is unreliable.
    return c == "Part" or c == "MeshPart" or c == "UnionOperation"
        or c == "WedgePart" or c == "CornerWedgePart"
end

local function bounds(main)
    local parts, stack = {}, { main }
    local walked = 0
    while #stack > 0 and walked < 2048 do
        local node = table.remove(stack)
        walked = walked + 1
        if isPart(node) then
            parts[#parts + 1] = node
        else
            for _, c in ipairs(node:GetChildren()) do stack[#stack + 1] = c end
        end
    end
    if #parts == 0 or #stack > 0 then return end
    local pivot = child(child(main, "Parts"), "Engine") or parts[1]
    local cf = pivot.CFrame
    if not cf or not vectorOK(cf.Position) then return end
    local lo = Vector3.new(math.huge, math.huge, math.huge)
    local hi = Vector3.new(-math.huge, -math.huge, -math.huge)
    for _, part in ipairs(parts) do
        local size, transform = part.Size, part.CFrame
        if not vectorOK(size) or not transform then return end
        for x = -1, 1, 2 do
            for y = -1, 1, 2 do
                for z = -1, 1, 2 do
                    local p = cf:PointToObjectSpace(transform:PointToWorldSpace(
                        Vector3.new(size.X*x/2, size.Y*y/2, size.Z*z/2)))
                    if not vectorOK(p) then return end
                    lo = Vector3.new(math.min(lo.X,p.X), math.min(lo.Y,p.Y), math.min(lo.Z,p.Z))
                    hi = Vector3.new(math.max(hi.X,p.X), math.max(hi.Y,p.Y), math.max(hi.Z,p.Z))
                end
            end
        end
    end
    local size = hi - lo
    if size.X <= 0 or size.Y <= 0 or size.Z <= 0
        or math.max(size.X,size.Y,size.Z) > 180 then return end
    local corners = {}
    for x = 0, 1 do
        for y = 0, 1 do
            for z = 0, 1 do
                corners[#corners + 1] = Vector3.new(
                    lo.X+size.X*x, lo.Y+size.Y*y, lo.Z+size.Z*z)
            end
        end
    end
    return pivot, corners, (lo + hi) * 0.5
end

local function maxHealth(model, stats)
    for _, container in ipairs({ stats, model }) do
        for _, name in ipairs({ "MaxHealth", "MaxHP", "MaxHullHealth" }) do
            local v = child(container, name)
            local n = v and v.Value
            if finite(n) and n > 0 then return n end
            local ok, attr = pcall(function() return container:GetAttribute(name) end)
            if ok and finite(attr) and attr > 0 then return attr end
        end
    end
end

local function collect()
    syncUI()
    camera = Workspace.CurrentCamera or Workspace:FindFirstChildOfClass("Camera")
    local byName, byTank = {}, {}
    for _, p in ipairs(Players:GetPlayers()) do
        byName[p.Name] = p
        -- Steel Titans Char points to Main.Parts.Engine, even with blank Owner.
        local value = child(p, "Char")
        local node = value and value.Value
        for depth = 1, 8 do
            if not node or not node.Address then break end
            if node.ClassName == "Model" and child(node, "Main") and child(node, "Stats") then
                byTank[node.Address] = p
                break
            end
            node = node.Parent
        end
    end
    local myTeam = LP.Team
    local myTeamName = myTeam and myTeam.Name
    local character = LP.Character
    local ownAddress = character and character.Address
    local out = {}
    S.FriendlyHidden, S.UnknownHidden = 0, 0
    S.TargetInfo = {}
    for _, model in ipairs(Workspace:GetChildren()) do
        if model.ClassName == "Model" then
            local main, stats = child(model,"Main"), child(model,"Stats")
            local hitboxes = child(main,"Hitboxes")
            local owner, alive = child(model,"Owner"), child(model,"Alive")
            local health = child(stats,"Health")
            if hitboxes and owner and alive and health then
                local ownerName, hp = owner.Value, health.Value
                local player = byTank[model.Address] or byName[ownerName]
                if player then ownerName = player.Name end
                local team = player and player.Team
                local friendly = myTeamName ~= nil and team ~= nil and team.Name == myTeamName
                local own = ownerName == LP.Name or (player and player.UserId == LP.UserId)
                    or (ownAddress ~= nil and model.Address == ownAddress)
                local knownTeam = myTeamName ~= nil and team ~= nil
                local filtered = C.TeamCheck and (friendly or not knownTeam)
                if not own and alive.Value == true and finite(hp) and hp > 0 then
                    if C.TeamCheck and friendly then S.FriendlyHidden = S.FriendlyHidden + 1 end
                    if C.TeamCheck and not knownTeam then S.UnknownHidden = S.UnknownHidden + 1 end
                end
                if not own and alive.Value == true and finite(hp) and hp > 0
                    and not filtered and #out < POOL_SIZE then
                    local pivot, corners, center = bounds(main)
                    if pivot then
                        local maxHP = maxHealth(model, stats)
                        local label = model.Name
                        if ownerName ~= "" then label = label .. " | " .. ownerName end
                        local info = ""

                        if C.Distance and camera then
                            local distance = (camera.CFrame.Position - pivot.CFrame:PointToWorldSpace(center)).Magnitude
                            info = info .. (info ~= "" and " | " or "") .. string.format("%.0f studs",distance)
                        end
                        local slot = S.Pool[#out + 1]
                        setLabel(slot.Name,label,blue)
                        setLabel(slot.Info,info,red)
                        setLabel(slot.HPText,string.format("HP %.0f",hp),green)
                        S.TargetInfo[#out + 1] = {
                            Owner = ownerName, Team = team and team.Name or "Unknown",
                            Friendly = friendly, Tank = model.Name
                        }
                        out[#out + 1] = { Pivot=pivot, Corners=corners, Center=center,
                            Health=health, Alive=alive, MaxHP=maxHP, Info=info ~= "" }
                    end
                end
            end
        end
    end
    targets = out
    S.Tracked = #out
end

local function renderTarget(t, d, camPos, vp, cameraCF, focal, occupied)
    if t.Alive.Value ~= true then return false end
    local hp = t.Health.Value
    if not finite(hp) or hp <= 0 then return false end
    local cf = t.Pivot.CFrame
    if not cf or not vectorOK(cf.Position) then return false end
    local center = cf:PointToWorldSpace(t.Center)
    if (camPos - center).Magnitude > C.MaxDistance then return false end
    local x0,y0,x1,y1 = math.huge,math.huge,-math.huge,-math.huge
    for _, corner in ipairs(t.Corners) do
        local p, visible = WorldToScreen(cf:PointToWorldSpace(corner))
        if not visible then
            -- WorldToScreen discards off-screen coordinates; project those
            -- corners ourselves so a partly visible tank retains its box.
            local q = cameraCF:PointToObjectSpace(cf:PointToWorldSpace(corner))
            if not vectorOK(q) or q.Z >= -0.1 then return false end
            p = Vector2.new(vp.X/2 + q.X*focal/(-q.Z), vp.Y/2 - q.Y*focal/(-q.Z))
        end
        if not p or not finite(p.X) or not finite(p.Y) then return false end
        x0,y0 = math.min(x0,p.X),math.min(y0,p.Y)
        x1,y1 = math.max(x1,p.X),math.max(y1,p.Y)
    end
    if x1 < 0 or y1 < 0 or x0 > vp.X or y0 > vp.Y then return false end
    local w,h = (x1-x0)*C.BoxScale,(y1-y0)*C.BoxScale
    w, h = math.max(4,w), math.max(4,h)
    local x,y = (x0+x1-w)/2,(y0+y1-h)/2
    local right,bottom = math.min(vp.X-1,x+w),math.min(vp.Y-1,y+h)
    x,y = math.max(1,x),math.max(1,y)
    w,h = right-x,bottom-y
    if w <= 0 or h <= 0 then return false end
    d.Outline.Position, d.Box.Position = Vector2.new(x,y), Vector2.new(x,y)
    d.Outline.Size, d.Box.Size = Vector2.new(w,h), Vector2.new(w,h)
    d.Outline.Visible, d.Box.Visible = C.Box,C.Box
    layoutLabels(d,x,y,w,h,vp,occupied)
    d.Health.Visible, d.HealthBG.Visible = false,false
    if C.Health and t.MaxHP then
        local ratio = math.max(0,math.min(1,hp/t.MaxHP))
        d.HealthBG.Position, d.HealthBG.Size = Vector2.new(x-7,y-1),Vector2.new(5,h+2)
        d.Health.Position, d.Health.Size = Vector2.new(x-6,y+h*(1-ratio)),Vector2.new(3,h*ratio)
        d.Health.Color = green
        d.HealthBG.Visible, d.Health.Visible = true,ratio > 0
    end
    d.Tracer.Visible = C.Tracer
    if C.Tracer then
        d.Tracer.From, d.Tracer.To = Vector2.new(vp.X/2,vp.Y-2),Vector2.new(x+w/2,y+h)
    end
    return true
end

local ok, err = pcall(setup)
if not ok then S.Stop(); error(err) end
connection = RunService.RenderStepped:Connect(function()
    if not S.Running then return end
    S.Frames = S.Frames + 1
    local visible = 0
    local okFrame, frameError = pcall(function()
        local camPos = camera and camera.CFrame.Position
        local vp = camera and camera.ViewportSize
        local cameraCF = camera and camera.CFrame
        local fov = camera and camera.FieldOfView or 70
        local focal = vp and vp.Y/(2*math.tan(math.rad(fov)/2))
        local occupied = {}
        for i, d in ipairs(S.Pool) do
            local t = targets[i]
            if C.Enabled and camPos and vp and t then
                local good, shown = pcall(renderTarget,t,d,camPos,vp,cameraCF,focal,occupied)
                if good and shown then visible = visible + 1
                else hide(d); if not good then report("render",shown) end end
            else hide(d) end
        end
    end)
    if not okFrame then
        report("frame",frameError)
        for _, d in ipairs(S.Pool) do hide(d) end
    end
    S.Visible = visible
end)

task.spawn(function()
    while S.Running do
        local good, problem = pcall(collect)
        if not good then targets = {}; S.Tracked = 0; report("collector",problem) end
        task.wait(0.4)
    end
end)
print("[Steel Titans v15] Started. Stop with _G.SteelTitansESP.Stop()")
